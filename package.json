{
  "name": "codewithme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "server": "tsx watch --clear-screen=false --env-file=.env.local server/index.ts",
    "worker": "tsx watch --clear-screen=false --env-file=.env.local server/worker.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "sandbox:images": "docker pull python:3.12-alpine && docker pull node:20-alpine && docker build -t codewithme-cpp sandbox/cpp",
    "dev:all": "concurrently -n next,server,worker -c blue,green,magenta \"npm:dev\" \"npm:server\" \"npm:worker\"",
    "build": "next build",
    "start": "next start",
    "start:server": "tsx server/index.ts",
    "start:worker": "tsx server/worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5.11.1",
    "monaco-editor": "^0.55.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0",
    "y-monaco": "^0.1.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
