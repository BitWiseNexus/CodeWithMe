# Copy this file to .env.local and fill in values from your Firebase project.

# Web app config (Project settings -> General -> Your apps -> Web app).
# These are public identifiers, safe to ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# SERVER-ONLY: Admin SDK service account (Project settings -> Service accounts
# -> Generate new private key). Used by Next.js, the worker and the seed
# script. Never prefix with NEXT_PUBLIC. Keep the quotes and the \n escapes.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Realtime servers (started by `npm run server`). The browser and the worker
# use these URLs to reach them.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:4444
# Read by the realtime server itself: its ports and the Next.js origin that
# CORS allows (set this to your deployed site's URL in production).
SOCKET_PORT=3001
SIGNALING_PORT=4444
CLIENT_ORIGIN=http://localhost:3000

# Execution sandbox (Redis queue + worker)
REDIS_URL=redis://localhost:6379
# Shared secret between the worker and the realtime server. Required when
# NODE_ENV=production — use a long random string there.
WORKER_SECRET=dev-worker-secret
# Optional. Stable worker name (default worker-<hostname>): after a crash or
# restart the worker resumes the jobs it had taken. Give each worker process
# on the same machine its own id.
# WORKER_ID=worker-1
# Optional. Sandboxes run at the same time (default 2; each gets 0.5 CPU).
# WORKER_CONCURRENCY=2
